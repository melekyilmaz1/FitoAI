datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Meal {
  id        String   @id @default(uuid())
  userId    String
  name      String
  mealType  String
  calories  Int
  protein   Float
  carbs     Float
  fat       Float
  portion   Float
  grammage  Float
  date      String
  createdAt DateTime @default(now())
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  date      String
  amountMl  Int
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}