datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  meals     Meal[]
  waterLogs WaterLog[]
}

model Meal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  mealType  String
  calories  Int
  protein   Float
  carbs     Float
  fat       Float
  portion   Float
  grammage  Float
  date      String
  createdAt DateTime @default(now())
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  amountMl  Int
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}